# ─── Database ────────────────────────────────────────────────
# Option 1: Local PostgreSQL (default for development & Docker)
DATABASE_URL="postgresql://scenarix:scenarix@127.0.0.1:5432/scenarix"
DIRECT_URL="postgresql://scenarix:scenarix@127.0.0.1:5432/scenarix"

# Option 2: Supabase (uncomment and fill in your project details)
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Dub / still object storage ──────────────────────────────
# local = $0 preview (public/media/dubs/...). supabase = production buckets.
DUB_STORAGE=local
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin credentials (used for seeding) ────────────────────
ADMIN_EMAIL=admin@scenarix.app
ADMIN_PASSWORD=changeme

# ─── Auth ─────────────────────────────────────────────────────
AUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ─── MCP Server ──────────────────────────────────────────────
# Required for Claude Code / Cursor / Codex MCP integration
CLI_API_KEY=your-cli-api-key-here
# Optional production-agent header x-kineva-task-token (do not commit the value)
# KINEVA_TASK_TOKEN=

# ─── AI APIs ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
LEONARDO_API_KEY=your_leonardo_api_key_here
LEONARDO_MODEL_ID=your_leonardo_model_id_here

# ─── Voice (default: free Microsoft neural via edge-tts) ────
# TTS_ENGINE=edge          # default. Use elevenlabs only after later tests.
# TTS_VOICE_EN=en-US-JennyNeural
# TTS_VOICE_ES=es-MX-DaliaNeural
# TTS_VOICE_TR=tr-TR-EmelNeural
# TTS_VOICE_DE=de-DE-KatjaNeural
# TTS_VOICE_AR=ar-SA-ZariyahNeural
# pip3 install -r requirements-tts.txt
#
# Optional later (not default; do not set until tests pass):
# TTS_ENGINE=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID_EN=
# ELEVENLABS_VOICE_ID_TR=
# ELEVENLABS_VOICE_ID_DE=
# ELEVENLABS_VOICE_ID_ES=
# ELEVENLABS_VOICE_ID_AR=

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Vercel / HTTPS cookies ──────────────────────────────────
# COOKIE_SECURE=1

# ─── Fal (mature/explicit stills; generate locked unless allowed) ─
# FAL_KEY=
# FAL_ALLOW_GENERATE=1
# Explicit SFW still override only (text stays Gemini). Do not set for silent fallback.
# SFW_IMAGE_PROVIDER=fal
