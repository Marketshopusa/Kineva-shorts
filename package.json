{
  "name": "scenarix",
  "version": "0.1.0",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' next dev --webpack",
    "dev:turbo": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "postinstall": "prisma generate",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-default-type=module --test tests/tts/*.test.mjs tests/storage/*.test.mjs tests/images/*.test.mjs tests/rails/*.test.mjs tests/watch/*.test.mjs tests/storyboard/*.test.mjs",
    "commit": "node scripts/ai-commit.mjs",
    "commit:watch": "node scripts/ai-commit.mjs --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@higgsfield/client": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@remotion/bundler": "^4.0.438",
    "@remotion/cli": "^4.0.438",
    "@remotion/player": "^4.0.438",
    "@remotion/renderer": "^4.0.438",
    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.3.0",
    "dotenv": "^17.3.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.438"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4"
  }
}
